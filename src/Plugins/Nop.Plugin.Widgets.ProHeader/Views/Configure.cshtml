@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))

<form asp-controller="ProHeader" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-header">
                        @T("Plugins.Widgets.ProHeader.Settings")
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Enabled" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Enabled" />
                                <span asp-validation-for="Enabled"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="BackgroundPictureId" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="BackgroundPictureId" />
                                <span asp-validation-for="BackgroundPictureId"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Text" />
                            </div>
                            <div class="col-md-9">
                                <nop-textarea asp-for="Text" rows="10"></nop-textarea>
                                <span asp-validation-for="Text"></span>
                                <div class="text-muted">@T("Plugins.Widgets.ProHeader.Text.Hint")</div>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="BackgroundColor" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="BackgroundColor" />
                                <span asp-validation-for="BackgroundColor"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="TextColor" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="TextColor" />
                                <span asp-validation-for="TextColor"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="OverlayOpacity" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="OverlayOpacity" />
                                <span asp-validation-for="OverlayOpacity"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DesktopHeight" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DesktopHeight" />
                                <span asp-validation-for="DesktopHeight"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="MobileHeight" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="MobileHeight" />
                                <span asp-validation-for="MobileHeight"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="AltText" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="AltText" />
                                <span asp-validation-for="AltText"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="offset-md-3 col-md-9">
                                <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
